{
  "name": "elara-one-landing-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "deploy:cloudflare": "npm run build && WRANGLER_LOG_PATH=/private/tmp/elara-wrangler.log wrangler deploy",
    "deploy:cloudflare:dry-run": "npm run build && WRANGLER_LOG_PATH=/private/tmp/elara-wrangler.log wrangler deploy --dry-run",
    "preview": "vite preview",
    "test": "node --test tests/waitlist.test.mjs tests/locale.test.mjs tests/content.test.mjs tests/p1-assets.test.mjs tests/japanese-page.test.mjs tests/p1-product.test.mjs tests/p1-risk.test.mjs tests/p1-funnel.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
